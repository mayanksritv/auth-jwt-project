{
  "info": {
    "_postman_id": "1ea7e6b1-3ae5-4ea6-9c50-0f3a3f6e6f0c",
    "name": "AuthVault \u2014 JWT Authentication",
    "description": "Postman collection for registration, login, protected JWT middleware and logout. JWT is stored automatically in the auth_token HTTP-only cookie by the API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "name",
      "value": "Mayank"
    },
    {
      "key": "email",
      "value": "mayank@example.com"
    },
    {
      "key": "password",
      "value": "Password@123"
    }
  ],
  "item": [
    {
      "name": "01 \u2014 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration succeeds', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 \u2014 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('User returned without password', function () { const body = pm.response.json(); pm.expect(body.user.password).to.be.undefined; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 \u2014 Protected Profile",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/protected/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "protected",
            "profile"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Protected route succeeds', function () { pm.response.to.have.status(200); });",
              "pm.test('JWT middleware authenticated the user', function () { const body = pm.response.json(); pm.expect(body.success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 \u2014 Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout succeeds', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
